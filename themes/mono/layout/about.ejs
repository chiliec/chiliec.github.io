<% var s = page.sections || {}; %>
<section class="about-hero" aria-labelledby="about-title">
  <p class="eyebrow" data-hero><%= page.tagline %></p>
  <h1 id="about-title" class="display about-title" data-split data-hero><%= page.title %></h1>
  <% if (s.about) { %>
    <p class="about-lede" data-hero><%= s.about.intro %></p>
    <% if (s.about.philosophy) { %><p class="about-philosophy" data-hero><em><%= s.about.philosophy %></em></p><% } %>
  <% } %>
</section>

<% if (s.drives) { %>
<section class="about-section" aria-labelledby="drives-title">
  <div class="section-mark"><span>01 / <%= s.drives.title %></span></div>
  <h2 id="drives-title" class="visually-hidden"><%= s.drives.title %></h2>
  <div class="about-prose" data-stagger>
    <% (s.drives.paragraphs || []).forEach(function (p) { %><%- markdown(p) %><% }) %>
  </div>
</section>
<% } %>

<% if (s.interests) { %>
<section class="about-section" aria-labelledby="interests-title">
  <div class="section-mark"><span>02 / <%= s.interests.title %></span></div>
  <h2 id="interests-title" class="visually-hidden"><%= s.interests.title %></h2>
  <ul class="interests-grid" data-stagger>
    <% (s.interests.items || []).forEach(function (item) { %>
      <li class="interest">
        <% if (item.icon) { %><%- partial('_partial/icon', { name: item.icon }) %><% } %>
        <span class="interest-name"><%= item.name %></span>
        <span class="interest-desc"><%= item.description %></span>
      </li>
    <% }) %>
  </ul>
</section>
<% } %>

<% if (s.contact) { %>
<section class="about-section" aria-labelledby="contact-title">
  <div class="section-mark"><span>03 / <%= s.contact.title %></span></div>
  <h2 id="contact-title" class="display section-title" data-split><%= s.contact.intro %></h2>
  <p class="hero-cta">
    <% (s.contact.links || []).forEach(function (link, i) { %>
      <a class="button<%= i === 0 ? ' button--solid' : '' %>" href="<%= link.url %>"<% if (link.target) { %> target="<%= link.target %>" rel="noopener"<% } %>><%= link.name %></a>
    <% }) %>
  </p>
</section>
<% } %>
