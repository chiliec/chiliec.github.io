<section class="site-intro">
  <p>iOS and macOS engineer, 10+ years shipping production Apple software. Swift, SwiftUI, UIKit; lately architecture-led delivery with AI agents.</p>
</section>
<ul class="post-list">
  <% site.posts.sort('date', -1).each(function(post) { %>
    <li class="post-list-item">
      <%- partial('_partial/post-meta', { post: post }) %>
      <a class="post-list-title" href="<%- url_for(post.path) %>"><%= post.title %></a>
    </li>
  <% }) %>
</ul>
