<% var apps = (site.data && site.data.apps) || []; %>
<section class="apps-hero" aria-labelledby="apps-title">
  <p class="eyebrow" data-hero><%= apps.length %> apps · App Store</p>
  <h1 id="apps-title" class="display apps-title" data-split data-hero><%= page.title %><% if (page.tagline) { %> — <em><%= page.tagline %></em><% } %></h1>
  <ul class="apps-icons" data-hero>
    <% apps.forEach(function (a) { %>
      <li><a href="#app-<%= a.id %>"><img src="<%= a.icon %>" alt="<%= a.name %>" width="96" height="96"></a></li>
    <% }) %>
  </ul>
</section>

<% apps.forEach(function (a, n) { %>
  <section class="app-feature" id="app-<%= a.id %>" aria-labelledby="app-<%= a.id %>-name">
    <div class="section-mark"><span><%= String(n + 1).padStart(2, '0') %> / <%= a.genre %></span><span>iOS <%= a.minOS %>+ · v<%= a.version %> · updated <%= a.updated %></span></div>
    <div class="app-feature-grid">
      <div class="app-feature-copy">
        <img class="app-feature-icon" src="<%= a.icon %>" alt="" width="72" height="72" loading="lazy">
        <h2 id="app-<%= a.id %>-name" class="display app-feature-name" data-split><%= a.name %></h2>
        <p class="app-feature-tagline"><%= a.tagline %></p>
        <a class="button button--solid" href="<%= a.url %>" target="_blank" rel="noopener">View on the App Store →<span class="visually-hidden"> (opens in new tab)</span></a>
      </div>
      <div class="app-shots">
        <% (a.screenshots || []).forEach(function (src, i) { %>
          <img src="<%= src %>" alt="<%= a.name %> screenshot <%= i + 1 %>" width="480" height="1043" loading="lazy" decoding="async" data-parallax>
        <% }) %>
      </div>
    </div>
  </section>
<% }) %>

<p class="apps-all">
  <a class="button" href="https://apps.apple.com/developer/id1557125814" target="_blank" rel="noopener">All apps on the App Store →<span class="visually-hidden"> (opens in new tab)</span></a>
</p>
