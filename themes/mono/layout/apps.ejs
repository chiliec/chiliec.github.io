<% const apps = (site.data && site.data.apps) || []; %>
<article class="about-page apps-page">
  <header class="about-header">
    <h1 class="post-title"><%= page.title %></h1>
    <% if (page.tagline) { %>
      <div class="about-tagline"><%= page.tagline %></div>
    <% } %>
  </header>

  <% if (apps.length) { %>
  <ul class="apps-list">
    <% apps.forEach(function(app) { %>
      <li class="app">
        <img class="app-icon" src="<%= app.icon %>" alt="<%= app.name %>" width="64" height="64" loading="lazy">
        <div class="app-body">
          <h2 class="app-name"><a href="<%= app.url %>" target="_blank" rel="noopener"><%= app.name %></a></h2>
          <p class="app-tagline"><%= app.tagline %></p>
          <p class="app-meta"><%= app.genre %> · iOS <%= app.minOS %>+ · v<%= app.version %> · updated <%= app.updated %></p>
          <a class="app-link" href="<%= app.url %>" target="_blank" rel="noopener">View on the App Store →</a>
        </div>
      </li>
    <% }) %>
  </ul>
  <% } %>

  <p class="apps-all">
    <a href="https://apps.apple.com/developer/id1557125814" target="_blank" rel="noopener">All apps on the App Store →</a>
  </p>
</article>
