.apps-list
  list-style none
  padding 0
  margin 0 0 var(--space-xl)

.app
  display grid
  grid-template-columns 64px 1fr
  column-gap var(--space-md)
  padding var(--space-md) 0
  border-bottom 1px dashed var(--rule)

.app-icon
  border-radius 14px
  width 64px
  height 64px

.app-name
  font-family var(--font-body)
  font-size 20px
  margin 0 0 var(--space-xs)

.app-name a
  color var(--fg)
  text-decoration none

.app-tagline
  margin 0 0 var(--space-xs)

.app-meta
  font-family var(--font-mono)
  font-size 11px
  color var(--muted)
  margin 0 0 var(--space-xs)

.app-link, .apps-all a
  font-family var(--font-mono)
  font-size 12px
  color var(--accent)
  text-decoration none

.apps-all
  font-family var(--font-mono)
  font-size 12px
